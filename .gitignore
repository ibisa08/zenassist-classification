# --- donnees ---------------------------------------------------------------
# TOUT `data/` est exclu, pas seulement raw/ et processed/. Enumerer les
# sous-repertoires connus laisserait passer un `data/interim/` ou un fichier
# depose a la racine de `data/` : la couverture doit etre explicite, pas un
# effet de bord de la structure actuelle.
# Le dataset brut fait 639 Mo et les fichiers derives sont integralement
# reproductibles par `python -m src.data_prep`.
data/

# --- secrets ---------------------------------------------------------------
# `.env` seul ne couvre pas `.env.local`, `.env.production`, `.env.staging`.
# On exclut toutes les variantes et on re-inclut le seul modele partageable.
.env
.env.*
!.env.example

# --- environnement ---------------------------------------------------------
.venv/
venv/
env/
ENV/

# --- notebooks -------------------------------------------------------------
.ipynb_checkpoints/

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- resultats intermediaires ----------------------------------------------
# scratch/ ne contient que des sous-produits regenerables (csv, npz, json de
# travail) deposes par les scripts de tools/. Aucune source n'y vit : les
# generateurs de livrables sont dans tools/ et sont versionnes, sans quoi ni le
# notebook ni les rapports ne seraient reproductibles sur un clone.
scratch/

# tools/ et tests/ sont versionnes :
#   tools/ = source de verite du notebook et des rapports chiffres
#   tests/ = seul code qui prouve que les garde-fous echouent quand ils doivent

# --- modeles ---------------------------------------------------------------
# Les pickles font ~90 Mo (9 classes x 1,24 M coefficients) et sont exclus au
# meme motif que data/ : ils sont reproductibles. Ce motif n'est pas une
# affirmation. `tools/export_modele.py` est deterministe et
# `tests/test_export_modele.py` le verifie -- deux ajustements, dans deux
# processus distincts, doivent donner la meme empreinte de contenu. Si ce test
# tombe, la ligne ci-dessous n'est plus justifiee.
#
# Le fichier de metadonnees, lui, EST versionne : il dit ce qu'un pickle
# contient sans qu'on ait a le charger (vectoriseur, classifieur et parametres,
# taille du vocabulaire, empreintes, scores, versions, date), et c'est lui qui
# permet de verifier un artefact telecharge depuis une release.
models/*
!models/*.metadata.json

# --- reglages locaux de l'editeur ------------------------------------------
# settings.local.json est par convention le fichier de preferences PERSONNELLES
# (chemins machine, nom d'utilisateur) : il ne se partage pas. Un
# .claude/settings.json de projet, lui, serait versionne.
.claude/settings.local.json

# --- rapports de controle CI ------------------------------------------------
# `tools/controle_ci.py` ecrit ses rapports dans sorties/. En integration
# continue ils sont publies comme assets de release ou comme artefacts du
# lancement manuel ; en local ce sont des fichiers de travail, dates de la
# derniere execution. Les versionner ferait croire a une reference alors que
# la seule reference est ci/reference.json.
sorties/

# --- systeme ---------------------------------------------------------------
.DS_Store
Thumbs.db

# --- plateforme JavaScript --------------------------------------------------
# Dependances et artefacts de build : reconstruits par npm install / npm run build.
javascript/node_modules/
javascript/.next/
javascript/out/
javascript/build/
javascript/.turbo/
javascript/coverage/
javascript/next-env.d.ts
javascript/*.tsbuildinfo
