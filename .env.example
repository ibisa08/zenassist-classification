# Copier ce fichier en `.env` et renseigner la cle.
# `.env` est dans le .gitignore : il ne doit JAMAIS etre commite.
#
#     cp .env.example .env

# Cle d'API Mistral, utilisee a l'etape 2 (approche LLM).
MISTRAL_API_KEY=

# Modele utilise. Le diagnostic chiffre le cout sur mistral-small-latest
# (0,10 $ / M tokens en entree, 0,30 $ / M en sortie au moment de la redaction).
MISTRAL_MODEL=mistral-small-latest
